---
// Link to the same page in the other language. Shows "中文" / "EN".
import { htmlLang, localeFromParams, localizedPath, otherLocales, useTranslations } from '../i18n';

interface Props {
  route: string;
  class?: string;
}
const locale = localeFromParams(Astro.params);
---
{otherLocales(locale).map((l) => {
  const t = useTranslations(l);
  return (
    <a class:list={['lang-link', Astro.props.class]} href={localizedPath(l, Astro.props.route)} hreflang={htmlLang[l]} lang={htmlLang[l]} title={t.a11y.switchLanguage}>
      {t.langShort}
    </a>
  );
})}

<style>
  .lang-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: 10px;
    color: var(--ink);
    font-weight: 500;
    text-decoration: none;
  }
  .lang-link:hover { color: var(--green-dark); }
  /* "中文" on English pages: system font, so English pages never download the Chinese web font. */
  .lang-link:lang(zh) { font-family: var(--font-cjk-system); }
</style>
