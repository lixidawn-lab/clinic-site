---
// Booking bar fixed to the bottom of the screen on phones and tablets (< 1100px; desktop has the header button).
// "WhatsApp" opens wa.me with the prefilled greeting (PRD 2.1); "Call" dials (tel:). No forms (CLAUDE.md rule 5).
// A button whose number is still TBC: inert with the TBC marker on the preview site, left out in production;
// with neither number the bar disappears.
import TBC from './TBC.astro';
import { localeFromParams, useTranslations } from '../i18n';
import { external, telHref, whatsappHref } from '../lib/links';
import { isShown } from '../lib/tbc';
import type { Settings } from '../lib/content';

interface Props {
  settings: Settings;
}

const { settings } = Astro.props;
const locale = localeFromParams(Astro.params);
const t = useTranslations(locale);
const wa = whatsappHref(settings.whatsapp, settings.bookingMessage[locale]);
const tel = telHref(settings.phone);
const showWa = isShown(settings.whatsapp);
const showTel = isShown(settings.phone);
---
{(showWa || showTel) && (
  <aside class="booking-bar" aria-label={t.a11y.bookingBar}>
    {showWa && (wa
      ? <a class="btn btn-primary wa" href={wa} {...external}>{t.cta.whatsappBook}</a>
      : <span class="btn btn-primary wa is-tbc">{t.cta.whatsappBook} <TBC value={settings.whatsapp} /></span>)}
    {showTel && (tel
      ? <a class="btn btn-secondary call" href={tel}>{t.cta.call}</a>
      : <span class="btn btn-secondary call is-tbc">{t.cta.call} <TBC value={settings.phone} /></span>)}
  </aside>
)}

<style>
  /* Sticky (not fixed): the bar keeps its own space at the end of the page, so it never covers the footer. */
  .booking-bar {
    position: sticky;
    bottom: 0;
    z-index: 30;
    display: flex;
    gap: 10px;
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
    background: var(--surface);
    border-top: 1px solid var(--line);
    box-shadow: 0 -4px 16px rgba(52, 66, 55, 0.08);
  }
  .btn { padding: 10px 12px; font-size: 16px; }
  .wa { flex: 1 1 0; }
  .call { flex: 0 0 112px; }
  .is-tbc { gap: 4px; font-size: 14px; }
  .call.is-tbc { flex: 0 1 auto; }
  @media (min-width: 1100px) {
    .booking-bar { display: none; }
  }
</style>
