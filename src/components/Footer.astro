---
// Footer (homepage design): logo + © clinic name; social links + privacy notice link; MAB approval number.
// The privacy notice is a page of its own (/<lang>/privacy/, decided 2026-10-23), linked only from here.
import Field from './Field.astro';
import Logo from './Logo.astro';
import { localeFromParams, localizedPath, useTranslations } from '../i18n';
import { legalRoutes } from '../lib/routes';
import { isShown } from '../lib/tbc';
import type { Settings } from '../lib/content';

interface Props {
  settings: Settings;
}

const { settings } = Astro.props;
const locale = localeFromParams(Astro.params);
const t = useTranslations(locale);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container inner">
    <p class="copyright">
      <Logo size={28} />
      {isShown(settings.clinicName[locale]) && <span>© {year} <Field value={settings.clinicName[locale]} /></span>}
    </p>
    <div class="links">
      {settings.socialLinks.length > 0 && (
        <ul class="social" aria-label={t.a11y.social}>
          {settings.socialLinks.map((s) => (
            <li><a href={s.url} rel="noopener me" target="_blank">{t.social[s.platform]}</a></li>
          ))}
        </ul>
      )}
      <a href={localizedPath(locale, legalRoutes.privacy)}>{t.footer.privacy}</a>
    </div>
    {isShown(settings.mabApprovalNo) && (
      <p class="mab">{t.footer.mabApprovalNo} <Field value={settings.mabApprovalNo} /></p>
    )}
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); font-size: var(--text-meta); color: var(--muted); }
  .inner {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 24px;
    padding-bottom: 32px;
  }
  p { margin: 0; }
  .copyright { display: flex; align-items: center; gap: 10px; }
  .copyright :global(img) { display: block; width: 28px; height: 28px; }
  .links { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 0 20px; }
  .social { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 20px; }
  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--muted);
  }
  a:hover { color: var(--green-dark); }
  @media (min-width: 860px) {
    .inner { flex-direction: row; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 24px; padding-top: 28px; padding-bottom: 36px; }
  }
</style>
