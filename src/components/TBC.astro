---
// Yellow "待补充 · TBC 3.4" marker for information the clinic hasn't confirmed yet (checklist number attached).
// `value` is the raw "TBC:3.4" string from content; `refNo` can be passed directly instead.
// Preview only: renders nothing in production (src/lib/preview.ts).
import { localeFromParams, useTranslations } from '../i18n';
import { showPreviewLabels } from '../lib/preview';
import { tbcRef } from '../lib/tbc';

interface Props {
  value?: string;
  refNo?: string;
}

const t = useTranslations(localeFromParams(Astro.params));
const ref = Astro.props.refNo ?? (Astro.props.value ? tbcRef(Astro.props.value) : '');
---
{showPreviewLabels && (
  <mark class="tbc" data-preview-label="tbc" data-tbc={ref}>
    {`${t.tbc.label} · TBC${ref ? ` ${ref}` : ''}`}
  </mark>
)}

<style>
  .tbc {
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--radius-small);
    background: var(--tbc-bg);
    color: var(--tbc-ink);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.5;
    vertical-align: middle;
    white-space: nowrap;
  }
</style>
