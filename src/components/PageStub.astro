---
// Phase-1 placeholder body for a main page. Replaced page by page in phase 2.
import { localeFromParams, useTranslations } from '../i18n';
import type { PageKey } from '../lib/routes';

interface Props {
  page: PageKey;
}
const t = useTranslations(localeFromParams(Astro.params));
---
<div class="container stub">
  <h1>{t.pages[Astro.props.page].title}</h1>
  <p>{t.stub.notice}</p>
  <slot />
</div>

<style>
  .stub { padding-block: 32px; max-width: var(--measure); }
</style>
