---
// Preview-only marker for drafted content Hanni hasn't confirmed yet. Renders nothing in production.
import { localeFromParams, useTranslations } from '../i18n';
import { showTbc } from '../lib/tbc';

const t = useTranslations(localeFromParams(Astro.params));
---
{showTbc && <span class="draft">{t.draft.label}</span>}

<style>
  .draft {
    display: inline-block;
    padding: 0 0.5em;
    border: 1px dashed currentColor;
    border-radius: var(--radius);
    font-size: 0.8em;
    font-weight: 400;
    white-space: nowrap;
  }
</style>
