---
// Short credentials list next to the portrait (homepage design): experience, languages, MMC number.
import { localeFromParams, useTranslations } from '../i18n';
import { listJoin } from '../lib/format';
import type { Doctor } from '../lib/content';

interface Props {
  doctor: Doctor;
}
const { doctor } = Astro.props;
const locale = localeFromParams(Astro.params);
const t = useTranslations(locale);
const mmc = doctor.showRegistrations ? doctor.registrations[0] : undefined;
---
<dl class="credentials">
  <div><dt>{t.credentials.experience}</dt><dd>{doctor.experience[locale]}</dd></div>
  <div><dt>{t.credentials.languages}</dt><dd>{listJoin(doctor.languages[locale], locale)}</dd></div>
  {mmc && <div><dt>{mmc.shortLabel[locale]}</dt><dd>{mmc.number}</dd></div>}
</dl>

<style>
  .credentials { margin: 0; display: flex; flex-direction: column; gap: 10px; font-size: 15px; line-height: 1.5; }
  .credentials div { display: flex; justify-content: space-between; gap: 16px; }
  dt { color: var(--muted); flex-shrink: 0; }
  dd { margin: 0; font-weight: 600; text-align: right; }
</style>
