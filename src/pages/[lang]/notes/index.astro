---
import Base from '../../../layouts/Base.astro';
import NoteList from '../../../components/NoteList.astro';
import { localeFromParams, localeStaticPaths, useTranslations } from '../../../i18n';
import { getNotes } from '../../../lib/content';
import { routes } from '../../../lib/routes';

export const getStaticPaths = localeStaticPaths;

const locale = localeFromParams(Astro.params);
const t = useTranslations(locale);
const page = t.pages.notes;
const notes = await getNotes();
const featured = notes.filter((n) => n.featured);
const latest = notes.filter((n) => !n.featured);
---
<Base title={page.title} description={page.description} route={routes.notes} nav="notes">
  <div class="container page">
    <h1>{page.title}</h1>
    <p>{page.description}</p>

    {featured.length > 0 && (
      <section>
        <h2>{t.notes.featured}</h2>
        <NoteList notes={featured} />
      </section>
    )}

    <section>
      <h2>{t.notes.latest}</h2>
      <NoteList notes={latest} />
    </section>
  </div>
</Base>
