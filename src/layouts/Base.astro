---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BookingCta from '../components/BookingCta.astro';
import JsonLd from '../components/JsonLd.astro';
import Analytics from '../components/Analytics.astro';
import { htmlLang, localeFromParams, useTranslations } from '../i18n';
import { getDoctor, getSettings } from '../lib/content';
import { isTbc } from '../lib/tbc';
import { medicalClinic } from '../lib/schema';
import type { PageKey } from '../lib/routes';

interface Props {
  title: string;
  description: string;
  /** Route without locale, e.g. "about". "" = home. */
  route: string;
  /** Highlights this item in the main nav. */
  nav?: PageKey;
  ogType?: 'website' | 'article';
  /** Republished article whose original lives elsewhere (CLAUDE.md「文章来源规则」). */
  externalCanonical?: string | null;
}

const { title, description, route, nav, ogType, externalCanonical } = Astro.props;
const locale = localeFromParams(Astro.params);
const t = useTranslations(locale);
const [settings, doctor] = await Promise.all([getSettings(), getDoctor()]);
const clinicName = settings.clinicName[locale];
const siteName = isTbc(clinicName) ? undefined : clinicName;
---
<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <SeoHead title={title} description={description} route={route} siteName={siteName} ogType={ogType} externalCanonical={externalCanonical} />
    <!-- Icons: scripts/build-images.mjs. The 16 px one shows only the chaise (the heart line is too thin at that size). -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <JsonLd data={medicalClinic(settings, locale, Astro.site!)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skipToContent}</a>
    <Header settings={settings} doctor={doctor} current={nav} route={route} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer settings={settings} />
    <BookingCta settings={settings} />
    <Analytics />
  </body>
</html>
