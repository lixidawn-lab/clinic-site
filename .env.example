# Search engines may index the site only when this is exactly "true".
# Anything else (or unset) => noindex,nofollow on every page + robots.txt "Disallow: /".
# Turning this on for production needs explicit sign-off from the site owner.
PUBLIC_ALLOW_INDEXING=false

# Real domain, used for canonical / hreflang / OG URLs. Placeholder until confirmed.
SITE_URL=https://example.com

# Empty fields ("TBC:x.x"): "true" shows the yellow TBC marker, "false" hides the field entirely.
# Leave unset: markers show while indexing is off (preview) and are hidden once it is on (production).
# PUBLIC_SHOW_TBC=
