# Search engines may index the site only when this is exactly "true".
# Anything else (or unset) => noindex,nofollow on every page + robots.txt "Disallow: /".
# Turning this on for production needs explicit sign-off from the site owner.
PUBLIC_ALLOW_INDEXING=false

# Domain used for canonical / hreflang / og:url / og:image / sitemap / JSON-LD. Default: https://clinic.bythewindow.org
SITE_URL=https://clinic.bythewindow.org

# Preview-only labels (TBC, 初稿 draft, 待涵倪审阅, 待取得转载许可): "true" shows them, "false" hides them all.
# Leave unset: they show while indexing is off (preview site) and disappear once it is on (production).
# PUBLIC_SHOW_PREVIEW_LABELS=
