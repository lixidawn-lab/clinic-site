// Cloudflare deploy config. The site is static: Cloudflare serves the files in dist/ as-is
// (public/_redirects included). "name" must stay "clinic-site" so deploys update the existing Worker.
// worker/index.js runs first on every request, only to send the workers.dev address to the official domain.
{
  "name": "clinic-site",
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
